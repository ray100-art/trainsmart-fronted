# Production / staging — set VITE_API_URL in the host (Vercel/nginx), do not hardcode in vercel.json.
#
# Same-origin API behind nginx (recommended for nhcsc.nascop.org):
# VITE_API_URL=/api/v1
#
# Explicit API host:
VITE_API_URL=https://nhcsc.nascop.org/api/v1
#
# Staging (Render example):
# VITE_API_URL=https://trainsmart-backend.onrender.com/api/v1
